def resolve_category_answer(raw: str, category: str):
    """Resolve a follow-up answer to a category clarification prompt
    (e.g. 'lower' after being asked which chest muscle) against that
    specific category's valid options -- checked before the general split
    system, so a bare word like 'lower' or 'upper' answers the pending
    chest/back/shoulders/triceps question instead of being hijacked by
    the Upper/Lower split. Returns a MUSCLE_DB key, or None if the input
    doesn't look like an answer to this category's question at all."""
    key = raw.strip().lower()
 
    for keywords, target in _CATEGORY_ANSWER_RULES.get(category, []):
        if any(kw in key for kw in keywords):
            return target
 
    # fallback: normal muscle matching, but only accepted if the result
    # is actually one of this category's valid options (covers legs/arms/
    # torso, and full-phrase answers like "serratus anterior")
    valid_keys = set(CATEGORY_GROUPS.get(category, []))
    normalized = normalize_input(raw)
    if normalized in valid_keys:
        return normalized
 
    return None
 
 
_UNMATCHED_INPUT_MESSAGES = [
    "Please enter a muscle.",
    "Hmm, I didn't catch that -- try naming a muscle, or ask for a workout split.",
    "That doesn't match anything I know. Try a muscle name (like 'biceps' or 'quads'), or ask for a split.",
    "Not sure what you mean -- type a muscle you want to train, or ask for a workout split.",
    "I don't recognize that one. Give me a muscle name, or ask for a split.",
]
 
 
_MUSCLE_INTENT_PHRASES = {
    "name a muscle", "a muscle", "muscle", "pick a muscle",
    "choose a muscle", "give me a muscle", "i want a muscle",
    "muscle please", "i want to name a muscle", "let me name a muscle",
    "i want to pick a muscle", "help me pick a muscle",
}
 
 
def is_muscle_intent(raw: str) -> bool:
    """Recognize a phrase like 'name a muscle' -- the user signaling they
    want to specify a muscle but hasn't named one yet -- with typo
    tolerance, same as the rest of the program's matching."""
    key = raw.strip().lower()
    if key in _MUSCLE_INTENT_PHRASES:
        return True
    return bool(get_close_matches(key, _MUSCLE_INTENT_PHRASES, n=1, cutoff=0.8))
 
 
def main():
    print("Welcome to BuildFitness.")
    print(
        "Tell me any muscle for a ranked list of the best exercises for "
        "it -- with the science behind why each one works and exactly "
        "how to train it -- or ask for a workout split to plan out your "
        "training week."
    )
    print()
 
    pending_days_family = None
    pending_category = None
    default_prompt = "What would you like to do -- name a muscle or ask for a split? "
    next_prompt = default_prompt
 
    while True:
        raw = input(next_prompt)
        next_prompt = default_prompt
        if raw.strip().lower() in ("quit", "exit", "q"):
            print("Goodbye!")
            break
 
        if not raw.strip():
            print("Please type a muscle name, or ask for a workout split.")
            continue
 
        # If we just asked "which muscle in your chest/back/shoulders/
        # triceps did you mean?", try to resolve this answer against that
        # specific category first -- this must run before the split
        # system, since answers like "upper"/"lower" would otherwise be
        # hijacked by the Upper/Lower split.
        if pending_category is not None:
            resolved = resolve_category_answer(raw, pending_category)
            pending_category = None
            if resolved is not None:
                print_report(resolved)
                sys.stdout.flush()
                print()
                continue
            # didn't look like an answer to the pending question -- fall
            # through and process this input normally below (so asking
            # for a split, or a completely different muscle, still works)
 
        # If we just asked "how many days a week do you want to workout?"
        # for a specific split family, try to parse a day count first.
        if pending_days_family is not None:
            day_count = parse_day_count(raw)
            if day_count is not None:
                print_program(pending_days_family, day_count)
                pending_days_family = None
                sys.stdout.flush()
                continue
            # A number was given but it's outside 1-7 -- ask again rather
            # than silently abandoning the split they already chose.
            if re.search(r"\d+", raw):
                print("\nPlease pick a number of days between 1 and 7.\n")
                sys.stdout.flush()
                next_prompt = "How many days a week do you want to workout? "
                continue
            # No number at all -- treat as a fresh input instead (a new
            # split, a muscle name, etc.)
            pending_days_family = None
 
        if is_muscle_intent(raw):
            next_prompt = "Great! Which muscle are you looking for? "
            continue
 
        split_result = resolve_split(raw)
        if split_result is not None:
            family_keys = list(SPLIT_FAMILIES.keys()) if split_result == "all" else [split_result]
            print_split_overview(family_keys)
            next_prompt = get_split_followup_prompt(family_keys)
            if len(family_keys) == 1:
                pending_days_family = family_keys[0]
            sys.stdout.flush()
            continue
 
        category = get_category(raw)
        if category is not None:
            print_category_prompt(category)
            pending_category = category
            sys.stdout.flush()
            continue
 
        muscle_key = normalize_input(raw)
        if muscle_key is None:
            print(f"\n{random.choice(_UNMATCHED_INPUT_MESSAGES)}\n")
            sys.stdout.flush()
            continue
 
        print_report(muscle_key)
        sys.stdout.flush()
        print()
 
 
if __name__ == "__main__":
    main()
 
