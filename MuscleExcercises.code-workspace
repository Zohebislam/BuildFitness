WEEKDAYS = [
    "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday",
    "Sunday",
]
 
 
def build_weekly_schedule(family_key: str, num_days: int):
    """Cycle through the family's day-type pattern for exactly num_days
    training days, then distribute those training days as evenly as
    possible across the 7-day week (rather than clumping them at the
    start), with every other day marked as rest. Returns a list of
    (weekday_name, day_type_or_None, muscle_keys_or_None) tuples."""
    pattern = SPLIT_FAMILIES[family_key]["pattern"]
    training_days = [pattern[i % len(pattern)] for i in range(num_days)]
 
    schedule = []
    training_index = 0
    for i in range(7):
        # Even-distribution check that starts from Monday (i=0) rather
        # than clustering toward the end of the week.
        is_training_day = (i * num_days) % 7 < num_days
        if is_training_day and training_index < len(training_days):
            day_type, muscle_keys = training_days[training_index]
            schedule.append((WEEKDAYS[i], day_type, muscle_keys))
            training_index += 1
        else:
            schedule.append((WEEKDAYS[i], None, None))
    return schedule
 
 
def resolve_split(raw: str):
    """Figure out what the user means by split-related input. Returns:
      family_key (str) -- one of SPLIT_FAMILIES' keys, unambiguously
                           identified (e.g. 'upper_lower')
      "all"            -- generic request; show every family
      None             -- not split-related at all (defer to the muscle
                           lookup system)
    """
    key = raw.strip().lower()
 
    # A full, exact muscle name/alias is never a split request, even if it
    # happens to contain "upper" or "lower" as a substring (e.g. "lower
    # chest", "lower back", "upper chest"). Checking this first protects
    # those unambiguous muscle phrases from the looser family-keyword
    # matching below, which only looks for "upper"/"lower" appearing
    # anywhere in the string.
    if key in MUSCLE_ALIASES:
        return None
 
    # Same protection, but for a TYPO of one of those phrases (e.g.
    # "upper chets" for "upper chest"). Checked directly against just
    # these specific muscle names (not the full alias list) so this stays
    # safe and predictable -- a real typo of the full phrase scores 0.9+,
    # while a bare "upper"/"lower" alone scores well below this cutoff and
    # correctly falls through to the split logic below.
    _upper_lower_muscle_phrases = [
        "upper chest", "upper pecs", "lower chest", "lower pecs",
        "upper back", "lower back",
    ]
    if get_close_matches(key, _upper_lower_muscle_phrases, n=1, cutoff=0.8):
        return None
 
    # Typo-correct against the family vocabulary before keyword logic.
    vocab = list(SPLIT_GENERIC_WORDS) + _SPLIT_FAMILY_VOCAB
    corrected = key
    if key not in vocab:
        fuzzy = get_close_matches(key, vocab, n=1, cutoff=0.78)
        if fuzzy:
            corrected = fuzzy[0]
 
    # Check "arnold" before the plain ppl/bro checks below -- otherwise
    # "push pull legs x arnold" would get swallowed by the plain PPL
    # match before ever being recognized as the hybrid. Checked against
    # the ORIGINAL key (not `corrected`) for the ppl/push/pull/legs
    # signal, same reasoning as the frequency-token protection elsewhere:
    # fuzzy-correcting a longer phrase can silently drop part of it.
    if "arnold" in corrected:
        if any(w in key for w in ("ppl", "push", "pull", "legs")):
            return "ppl_arnold_split"
        return "arnold_split"
 
    if "upper" in corrected or "lower" in corrected:
        return "upper_lower"
    if any(w in corrected for w in ("full body", "fullbody", "full-body")):
        return "full_body"
    if any(w in corrected for w in ("ppl", "push pull legs", "push/pull/legs")):
        return "ppl"
    if "anterior" in corrected or "posterior" in corrected:
        return "anterior_posterior"
    if "bro" in corrected:
        return "bro_split"
 
    words = key.split()
    if (
        corrected in SPLIT_GENERIC_WORDS
        or "split" in words
        or "splits" in words
    ):
        return "all"
 
    return None
 
 
def print_split_overview(family_keys):
    """Print the description(s) for the given split family key(s) -- a
    single family when one was unambiguously named, or all of them for a
    generic 'split' request."""
    print()
    print("=" * 80)
    if len(family_keys) == 1:
        print(f"  {SPLIT_FAMILIES[family_keys[0]]['display_name'].upper()}")
    else:
        print("  WORKOUT SPLITS")
    print("=" * 80)
    if len(family_keys) > 1:
        print_wrapped(
            "Which of these fits your week? Once you pick one, I'll ask "
            "how many days you want to train and build the exact program "
            "around that number.",
            indent=""
        )
        print("-" * 80)
 
    for fk in family_keys:
        fam = SPLIT_FAMILIES[fk]
        if len(family_keys) > 1:
            print(f"\n{fam['display_name']}")
        print_wrapped(fam["description"], indent="  " if len(family_keys) > 1 else "")
 
    print("\n" + "=" * 80)
    print()
 
 
def get_split_followup_prompt(family_keys):
    """Return the input-prompt text to use for the NEXT input, given the
    family key(s) just shown -- so the follow-up question replaces the
    standard prompt entirely instead of being printed as an extra line
    before it."""
    if len(family_keys) > 1:
        return "What split would you like to pick? "
    return "How many days a week do you want to workout? "
 
 
def print_program(family_key: str, num_days: int):
    fam = SPLIT_FAMILIES[family_key]
    schedule = build_weekly_schedule(family_key, num_days)
 
    print()
    print("=" * 80)
    print(f"  YOUR PROGRAM: {fam['display_name'].upper()} -- {num_days} DAYS/WEEK")
    print("=" * 80)
    print_wrapped(
        "Below is the #1 ranked exercise for each muscle trained that "
        "day, with its training protocol. Type any muscle name above at "
        "any time to see the full ranked list and alternatives for it.",
        indent=""
    )
    print("-" * 80)
 
    rest_days = []
    for weekday, day_type, muscle_keys in schedule:
        if day_type is None:
            rest_days.append(weekday)
            continue
        print(f"\n{weekday} - {day_type}")
        for mkey in muscle_keys:
            muscle = MUSCLE_DB[mkey]
            top_exercise = muscle.exercises[0]
            protocol = get_protocol(top_exercise.name)
            print(f"  {muscle.display_name}: {top_exercise.name}")
            print(f"    -> {protocol}")
 
    if rest_days:
        print(f"\nRest: {', '.join(rest_days)}")
        print_wrapped(
            "Recovery is when the muscles you trained actually adapt and "
            "rebuild from the stimulus -- these days are part of the "
            "program, not time off from it.",
            indent="  "
        )
 
    print("\n" + "=" * 80)
    print()
    day_word = "day" if num_days == 1 else "days"
    print_wrapped(
        f"Here is your new split! You picked {fam['display_name']} "
        f"training {num_days} {day_word} a week. I've built out the full "
        f"week above: every day, every muscle trained that day, the "
        f"single best exercise for it, and exactly how to train it.",
        indent=""
    )
    print()
 
 
def parse_day_count(raw: str):
    """Extract a number of training days (1-7) from a free-text answer to
    'how many days a week do you want to workout?' -- accepts a bare
    number ('4') or a natural phrase ('4 days', '4 days a week', etc.).
    Returns the integer if a valid 1-7 value is found, otherwise None."""
    match = re.search(r"-?\d+", raw)
    if not match:
        return None
    n = int(match.group())
    if 1 <= n <= 7:
        return n
    return None
 
 
 
