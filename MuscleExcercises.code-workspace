    print()
    print("Best exercises for this muscle, ranked BEST -> WORST:")
    print_wrapped(
        "(judged on: stretch-mediated tension, resistance profile, "
        "direct vs. shared tension, range of motion, stability demands, "
        "motor unit recruitment, and progressive overload potential)",
        indent=""
    )
    print("-" * 80)
 
    for rank, ex in enumerate(muscle.exercises, start=1):
        print(f"\n#{rank}. {ex.name}")
        print("    How it works the muscle (mechanism):")
        print_wrapped(ex.mechanism, indent="      ")
        print("    Why it is ranked here:")
        print_wrapped(ex.why_ranked, indent="      ")
        print("    Best method:")
        print_wrapped(get_protocol(ex.name), indent="      ")
 
    print("\n" + "=" * 80)
 
 
