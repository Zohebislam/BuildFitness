# ---------------------------------------------------------------------------
# TRAINING PROTOCOL ("best method") PER EXERCISE
#
# Universal philosophy applied throughout: no generic "3 sets of X" advice.
# Every exercise gets one of three evidence-informed protocols:
#   - 2 sets to true failure
#   - 1 set x ~6 reps, stopping 1 rep short of failure (1 RIR)
#   - 1 set to true failure
#
# Which protocol (and rep range) fits depends on the exercise's injury
# risk profile if pushed to true failure:
#   - Heavy free-weight lifts where failing under load is genuinely risky
#     (getting pinned under a bar, losing balance with a heavy weight
#     overhead, spinal fatigue) use the 1 RIR version instead of failure.
#   - Machine/cable movements run on a fixed, supported path where failure
#     just means the weight stops moving (no fall risk) can be safely
#     taken to true failure, and can absorb 2 sets to failure.
#   - Free-weight isolation, unilateral, and bodyweight movements are
#     lower-risk than heavy bilateral barbell lifts but still benefit from
#     just 1 set to true failure rather than 2.
# ---------------------------------------------------------------------------
 
_PROTOCOL_1RIR_KEYWORDS = [
    "squat", "deadlift", "good morning", "overhead press", "bench press",
    "incline barbell", "decline barbell",
]
 
_PROTOCOL_2X_FAILURE_KEYWORDS = [
    "cable", "machine", "leg press", "leg extension", "leg curl",
    "pushdown", "fly", "pulldown", "pec-deck", "face pull", "woodchopper",
    "pallof", "chest-supported row", "seated cable row", "preacher curl",
    "wrist curl", "calf raise (bent knee)", "seated calf raise",
    "leg press calf raise", "adduction", "hip flexion (standing",
    "internal rotation", "external rotation",
]
 
# Exact-substring overrides for exercises that don't fit the rep-based
# buckets cleanly (time-based holds, endurance-style, or unusual cases).
_PROTOCOL_OVERRIDES = {
    "farmer's carry": "1 set, carried for maximum time with good posture "
                       "(aim to approach failure by roughly 30-60 seconds)",
    "firm sugar-free chewing gum": "Not set-based -- one extended chewing "
                                    "session of roughly 10-20 minutes",
    "progressive jaw-resistance device": "1 set to failure x 15-20 "
                                          "controlled bites",
    "standing march": "1 set to failure x 15-25 reps per leg",
    "heel walks": "1 set, walked for maximum distance/time with good form",
    "nordic hamstring curl": "1 set, as many controlled reps as possible "
                              "before form breaks down (typically 3-8)",
}
 
 
def get_protocol(exercise_name: str) -> str:
    """Return the training protocol ('best method') for an exercise: one
    of 2 sets to failure, 1 set x ~6 with 1 rep in reserve, or 1 set to
    failure -- never a generic '3 sets' prescription."""
    name = exercise_name.lower()
 
    for key, protocol in _PROTOCOL_OVERRIDES.items():
        if key in name:
            return protocol
 
    if any(k in name for k in _PROTOCOL_1RIR_KEYWORDS):
        return "1 set x 5-8 reps, stopping 1 rep short of failure (1 RIR)"
 
    if any(k in name for k in _PROTOCOL_2X_FAILURE_KEYWORDS):
        return "2 sets to true failure x 8-15 reps each"
 
    # bodyweight-only movements suit a higher rep target before failure
    bodyweight_keywords = [
        "push-up", "bodyweight", "crunch", "sit-up", "hanging leg",
        "hanging knee", "wheel rollout", "bench dip", "ring dip",
    ]
    if any(k in name for k in bodyweight_keywords):
        return "1 set to true failure x 15-25 reps"
 
    # default: free-weight isolation, unilateral, or dumbbell movements
    return "1 set to true failure x 10-15 reps"
 
 
