def _singular_plural_variants(word: str):
    """Generate plausible singular/plural spellings of a single word so
    'calf' matches 'calves', 'glute' matches 'glutes', 'bicep' matches
    'biceps', etc. -- without needing every variant hardcoded as an alias."""
    variants = {word}
 
    # plural -> singular guesses
    if word.endswith("ves"):
        variants.add(word[:-3] + "f")    # calves -> calf
        variants.add(word[:-3] + "fe")   # (covers -ife/-afe style words)
    if word.endswith("es"):
        variants.add(word[:-2])          # glutes -> glut (harmless extra guess)
    if word.endswith("s") and not word.endswith("ss"):
        variants.add(word[:-1])          # biceps -> bicep, delts -> delt
 
    # singular -> plural guesses
    if word.endswith("f"):
        variants.add(word[:-1] + "ves")  # calf -> calves
    if word.endswith("fe"):
        variants.add(word[:-2] + "ves")  # -fe -> -ves
    if not word.endswith("s"):
        variants.add(word + "s")         # glute -> glutes, delt -> delts
        variants.add(word + "es")        # covers -es plurals
 
    return variants
 
 
def normalize_input(raw: str):
    """Map ANY free-text muscle name to a key in MUSCLE_DB using aliases
    (including anatomical/Latin names and everyday nicknames), automatic
    singular/plural handling, and a fuzzy match fallback for typos or
    near-misses."""
    key = raw.strip().lower()
 
    if key in MUSCLE_ALIASES:
        return MUSCLE_ALIASES[key]
 
    # Try singular/plural variants of the whole phrase and of each word in
    # it, so "calf" matches "calves", "glute" matches "glutes",
    # "quadricep" matches "quadriceps", etc. -- for every muscle, without
    # needing each form hardcoded in MUSCLE_ALIASES.
    words = key.split()
    for candidate in _singular_plural_variants(key):
        if candidate in MUSCLE_ALIASES:
            return MUSCLE_ALIASES[candidate]
 
    if len(words) > 1:
        # multi-word input: vary just the last word (e.g. "hip flexor" ->
        # "hip flexors") since that's almost always where the plural sits
        for last_variant in _singular_plural_variants(words[-1]):
            candidate = " ".join(words[:-1] + [last_variant])
            if candidate in MUSCLE_ALIASES:
                return MUSCLE_ALIASES[candidate]
 
    # try fuzzy matching against every known alias phrase (high threshold
    # to avoid false positives between unrelated short words, e.g.
    # "arms" incorrectly matching "hams")
    matches = get_close_matches(key, MUSCLE_ALIASES.keys(), n=1, cutoff=0.80)
    if matches:
        return MUSCLE_ALIASES[matches[0]]
 
    # try fuzzy matching word-by-word (helps with things like
    # "vastus lateralis" -> falls back toward "quadriceps" via "quad").
    # Skip very short words entirely -- short words are where false
    # positives like "arms" vs "hams" happen, and a genuine typo of a
    # short muscle name is better left unmatched than silently wrong.
    for word in words:
        if len(word) < 5:
            continue
        for candidate in _singular_plural_variants(word):
            word_matches = get_close_matches(
                candidate, MUSCLE_ALIASES.keys(), n=1, cutoff=0.80
            )
            if word_matches:
                return MUSCLE_ALIASES[word_matches[0]]
 
    return None
 
 
